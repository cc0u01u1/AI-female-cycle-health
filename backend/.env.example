# DeepSeek API Key（必填才能调用真实 AI 服务；不要提交真实 Key 到 Git）
DEEPSEEK_API_KEY=

# DeepSeek 服务地址与模型（可选，有默认值）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 请求超时（秒）
REQUEST_TIMEOUT=30

# CORS 允许来源（逗号分隔；生产环境请改为实际前端域名）
ALLOWED_ORIGINS=http://localhost:5173

# 本地联调 Mock 开关（不调用 DeepSeek，直接返回结构化示例；生产必须为 false）
ENABLE_MOCK=false
